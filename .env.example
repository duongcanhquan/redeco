# ============================================================
# Optimake — Environment variables (mẫu)
# Copy thành .env / apps/api/.env và điền giá trị thật.
# KHÔNG BAO GIỜ commit tệp .env chứa giá trị thật.
# ============================================================

# --- Supabase / PostgreSQL ---
# Transaction-mode pooler (runtime queries, pgbouncer)
DATABASE_URL="postgresql://postgres.unekhffoqackhzczaasy:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (migrations)
DIRECT_URL="postgresql://postgres.unekhffoqackhzczaasy:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase API (lấy từ Dashboard > Settings > API)
SUPABASE_URL="https://unekhffoqackhzczaasy.supabase.co"
SUPABASE_ANON_KEY=""
# Service role — CHỈ dùng cho admin jobs/migrations, cấm dùng trong luồng nghiệp vụ (xem database.mdc)
SUPABASE_SERVICE_ROLE_KEY=""

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="optimake-metadata"

# --- API ---
PORT=3001

# --- Web (Next.js — biến public phải có prefix NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL="https://unekhffoqackhzczaasy.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
