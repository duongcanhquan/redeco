{
  "name": "optimake",
  "version": "0.1.0",
  "private": true,
  "description": "Optimake - Multi-tenant SaaS ERP/MES - TypeScript, Next.js, NestJS, Supabase (PostgreSQL + RLS), Cloudflare R2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @optimake/web dev",
    "dev:api": "pnpm --filter @optimake/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "prettier": "^3.4.2",
    "supabase": "^2.111.0",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@supabase/server": "^1.4.1"
  }
}
